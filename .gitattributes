# Keep shell scripts LF so shebangs work when cloned on Linux/macOS.
*.sh text eol=lf
delegate.py text eol=lf
# -text, not eol=crlf: the plugin scanner refuses any eol setting other than eol=lf.
*.ps1 -text
graphify-out/graph.json merge=graphify

# The published ledger snapshot is written with LF by write_snapshot(); keeping it
# LF in the worktree too stops every refresh from producing a line-ending-only diff.
*.jsonl text eol=lf
